# Copy this file to ".env" and fill in your own values. NEVER commit ".env".
# Bu dosyayı ".env" adıyla kopyala ve kendi değerlerini yaz. ".env" dosyasını ASLA yükleme.

GEMINI_API_KEY=your_gemini_api_key_here

# The number after /job-search/ in the address bar of YOUR Handshake job search.
# Kendi Handshake ilan aramanın adres çubuğunda /job-search/ ifadesinden sonra gelen sayı.
HANDSHAKE_SEARCH_ID=your_search_id_here
